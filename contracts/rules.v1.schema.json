{
  "$defs": {
    "BatchPolicy": {
      "additionalProperties": false,
      "description": "How a forEach fan-out is issued when the step accepts a list (\u00a719).",
      "properties": {
        "mode": {
          "default": "auto",
          "description": "auto: items whose other params match are merged into one call per chunk; items: one call per item.",
          "enum": [
            "auto",
            "items"
          ],
          "type": "string"
        },
        "size": {
          "default": 100,
          "description": "Max items per merged call.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "EventTrigger": {
      "additionalProperties": false,
      "description": "Fires on any DataHub EntityChangeEvent (\u00a721): a category of change, optionally narrowed by\noperation, entity type, the event's ``modifier`` (the tag / term / owner / domain / property\nurn) and matches on its ``parameters``. Categories and operations are free strings \u2014 GMS adds\nthem without a release of this package; see ``KNOWN_TRIGGERS`` for the published vocabulary.",
      "properties": {
        "type": {
          "const": "event",
          "type": "string"
        },
        "category": {
          "description": "TAG, GLOSSARY_TERM, OWNERSHIP, DOMAIN, DEPRECATION, LIFECYCLE, STRUCTURED_PROPERTY, TECHNICAL_SCHEMA, DOCUMENTATION, BUSINESS_ATTRIBUTE, RUN, INCIDENT, \u2026",
          "minLength": 1,
          "type": "string"
        },
        "operations": {
          "description": "ADD, REMOVE, MODIFY, CREATE, HARD_DELETE, SOFT_DELETE, REINSTATE, STARTED, COMPLETED, ACTIVE, RESOLVED, \u2026 Empty = any.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "entityTypes": {
          "description": "Entity names as the event carries them (dataset, schemaField, container, \u2026). Empty = any.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "modifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueMatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Match on the event's modifier \u2014 the tag / term / owner / domain / property urn."
        },
        "parameters": {
          "description": "All must hold; `field` is a dotted path into the event's parameters (e.g. status, modificationCategory).",
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "type": "array"
        },
        "ignoreOwnChanges": {
          "default": true,
          "description": "Skip events caused by this engine's own steps, so a rule cannot re-trigger itself.",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "category"
      ],
      "type": "object"
    },
    "Filter": {
      "additionalProperties": false,
      "description": "One condition over a dotted path into the context document.",
      "properties": {
        "field": {
          "description": "Dotted path, e.g. form.field_abc, entity.type, requester.groups",
          "minLength": 1,
          "type": "string"
        },
        "condition": {
          "default": "EQUAL",
          "enum": [
            "EQUAL",
            "CONTAIN",
            "START_WITH",
            "END_WITH",
            "EXISTS",
            "IN",
            "GREATER_THAN",
            "LESS_THAN",
            "MATCHES"
          ],
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "negated": {
          "default": false,
          "type": "boolean"
        },
        "caseInsensitive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "FilterGroup": {
      "additionalProperties": false,
      "description": "AND/OR over conditions; groups nest (``(A and B) or C``).",
      "properties": {
        "operator": {
          "enum": [
            "AND",
            "OR"
          ],
          "type": "string"
        },
        "filters": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/FilterGroup"
              },
              {
                "$ref": "#/$defs/Filter"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "operator"
      ],
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 1,
          "description": "Total attempts including the first.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "backoff": {
          "default": "exponential",
          "enum": [
            "fixed",
            "exponential"
          ],
          "type": "string"
        },
        "delaySeconds": {
          "default": 1.0,
          "minimum": 0,
          "type": "number"
        },
        "maxDelaySeconds": {
          "default": 60.0,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workflowUrn": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Workflow triggers only."
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "on": {
          "discriminator": {
            "mapping": {
              "event": "#/$defs/EventTrigger",
              "schedule": "#/$defs/ScheduleTrigger",
              "workflow": "#/$defs/WorkflowTrigger"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WorkflowTrigger"
            },
            {
              "$ref": "#/$defs/EventTrigger"
            },
            {
              "$ref": "#/$defs/ScheduleTrigger"
            }
          ]
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "onError": {
          "default": "fail",
          "description": "Default error policy for steps.",
          "enum": [
            "fail",
            "continue",
            "stop"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "on"
      ],
      "type": "object"
    },
    "ScheduleTrigger": {
      "additionalProperties": false,
      "description": "Fires on a cron schedule (\u00a721 E4). The engine keeps one scheduler per executor pool, so\nkeep a rule's schedule on one pool. Ticks missed while the engine was down are skipped\nunless ``catchUp`` is set (then each missed tick runs, oldest first).",
      "properties": {
        "type": {
          "const": "schedule",
          "type": "string"
        },
        "cron": {
          "description": "5-field cron expression, e.g. `0 6 * * 1-5`.",
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "description": "IANA zone the cron is read in, e.g. Europe/Berlin.",
          "type": "string"
        },
        "catchUp": {
          "default": false,
          "description": "Run every tick missed while the engine was down (oldest first) instead of only the latest.",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "cron"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "description": "A step type from the catalog (add_tag, webhook, \u2026).",
          "minLength": 1,
          "type": "string"
        },
        "params": {
          "description": "Templated values ({{ path }}).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "onError": {
          "anyOf": [
            {
              "enum": [
                "fail",
                "continue",
                "stop"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the rule default (fail)."
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forEach": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path or template yielding a list; the step runs once per element as `item`."
        },
        "itemWhen": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "With forEach: conditions evaluated per element (`item`, `index` in scope); non-matching items are skipped."
        },
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "With forEach on a step that accepts a list: merge items into bulk calls (default auto, 100 per call)."
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template; defaults to event id + rule id + step id (+ item index)."
        }
      },
      "required": [
        "id",
        "type"
      ],
      "type": "object"
    },
    "ValueMatch": {
      "additionalProperties": false,
      "description": "A match on a single value (the event's ``modifier``): same conditions as a Filter, no path.",
      "properties": {
        "condition": {
          "default": "EQUAL",
          "enum": [
            "EQUAL",
            "CONTAIN",
            "START_WITH",
            "END_WITH",
            "EXISTS",
            "IN",
            "GREATER_THAN",
            "LESS_THAN",
            "MATCHES"
          ],
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "negated": {
          "default": false,
          "type": "boolean"
        },
        "caseInsensitive": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "WorkflowTrigger": {
      "additionalProperties": false,
      "description": "Fires on a workflow request's lifecycle (created / step decided / completed).",
      "properties": {
        "type": {
          "const": "workflow",
          "default": "workflow",
          "type": "string"
        },
        "operation": {
          "enum": [
            "CREATE",
            "PENDING",
            "MODIFY",
            "COMPLETED"
          ],
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "enum": [
                "ACCEPTED",
                "REJECTED",
                "CANCELLED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "COMPLETED: the request outcome. MODIFY: the step decision."
        },
        "stepId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MODIFY only: restrict to one approval step."
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    }
  },
  "description": "``source.config`` of the recipe. Other keys in the block are opaque.",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "type": "array"
    }
  },
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acryl.io/schemas/datahub-workflow-actions/v1.json",
  "title": "DataHub workflow-actions rules"
}
