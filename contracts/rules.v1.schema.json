{
  "$defs": {
    "BatchPolicy": {
      "additionalProperties": false,
      "description": "How a forEach fan-out is issued when the step accepts a list (\u00a719).",
      "properties": {
        "mode": {
          "default": "auto",
          "description": "auto: items whose other params match are merged into one call per chunk; items: one call per item.",
          "enum": [
            "auto",
            "items"
          ],
          "type": "string"
        },
        "size": {
          "default": 100,
          "description": "Max items per merged call.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Filter": {
      "additionalProperties": false,
      "description": "One condition over a dotted path into the context document.",
      "properties": {
        "field": {
          "description": "Dotted path, e.g. form.field_abc, entity.type, requester.groups",
          "minLength": 1,
          "type": "string"
        },
        "condition": {
          "default": "EQUAL",
          "enum": [
            "EQUAL",
            "CONTAIN",
            "START_WITH",
            "END_WITH",
            "EXISTS",
            "IN",
            "GREATER_THAN",
            "LESS_THAN",
            "MATCHES"
          ],
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "negated": {
          "default": false,
          "type": "boolean"
        },
        "caseInsensitive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "FilterGroup": {
      "additionalProperties": false,
      "description": "AND/OR over conditions; groups nest (``(A and B) or C``).",
      "properties": {
        "operator": {
          "enum": [
            "AND",
            "OR"
          ],
          "type": "string"
        },
        "filters": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/FilterGroup"
              },
              {
                "$ref": "#/$defs/Filter"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "operator"
      ],
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 1,
          "description": "Total attempts including the first.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "backoff": {
          "default": "exponential",
          "enum": [
            "fixed",
            "exponential"
          ],
          "type": "string"
        },
        "delaySeconds": {
          "default": 1.0,
          "minimum": 0,
          "type": "number"
        },
        "maxDelaySeconds": {
          "default": 60.0,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workflowUrn": {
          "minLength": 1,
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "on": {
          "$ref": "#/$defs/Trigger"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "onError": {
          "default": "fail",
          "description": "Default error policy for steps.",
          "enum": [
            "fail",
            "continue",
            "stop"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "workflowUrn",
        "on"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "description": "A step type from the catalog (add_tag, webhook, \u2026).",
          "minLength": 1,
          "type": "string"
        },
        "params": {
          "description": "Templated values ({{ path }}).",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "onError": {
          "anyOf": [
            {
              "enum": [
                "fail",
                "continue",
                "stop"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the rule default (fail)."
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forEach": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path or template yielding a list; the step runs once per element as `item`."
        },
        "itemWhen": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "With forEach: conditions evaluated per element (`item`, `index` in scope); non-matching items are skipped."
        },
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "With forEach on a step that accepts a list: merge items into bulk calls (default auto, 100 per call)."
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template; defaults to event id + rule id + step id (+ item index)."
        }
      },
      "required": [
        "id",
        "type"
      ],
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "description": "Which lifecycle event fires the rule.",
      "properties": {
        "operation": {
          "enum": [
            "CREATE",
            "PENDING",
            "MODIFY",
            "COMPLETED"
          ],
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "enum": [
                "ACCEPTED",
                "REJECTED",
                "CANCELLED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "COMPLETED: the request outcome. MODIFY: the step decision."
        },
        "stepId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MODIFY only: restrict to one approval step."
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    }
  },
  "description": "``source.config`` of the recipe. Other keys in the block are opaque.",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "type": "array"
    }
  },
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acryl.io/schemas/datahub-workflow-actions/v1.json",
  "title": "DataHub workflow-actions rules"
}
