        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          },
          {
            "items": {},
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Form answers for the new request by field id, e.g. {\"f_reason\": \"{{ form.f_reason }}\", \"f_owner\": \"{{ requester.urn }}\"}. A list fills a multi-value field."
